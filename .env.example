# ============================================================================
# BountyPilot AI — environment variables explained
# ============================================================================
#
# WHAT THIS FILE IS
#
#   This is a TEMPLATE and a manual, not something BountyPilot reads.
#   BountyPilot never looks at ".env.example" — it only reads a file literally
#   named ".env" in the directory you run the `bountypilot` command from.
#
#   To use it:
#
#     cp .env.example .env      # then edit .env with any text editor
#
#   Everything works out of the box with NO .env file at all. Create one only
#   if you want to change a default — for example to point the AI provider at
#   a remote model or to move the data directory. You never need to uncomment
#   or fill in every line: set only what you actually want to change.
#
#   30-second version:
#
#     - Want the default experience?            -> delete .env, you're done.
#     - Want AI analysis via an OpenAI-API-     -> set AI_PROVIDER=remote,
#       compatible endpoint (OpenAI, OpenRouter,   AI_BASE_URL, AI_MODEL,
#       Groq, a local llama.cpp server, ...)?      AI_API_KEY.
#     - Want to use the official @gibwork CLI   -> set GIBWORK_INTEGRATION_MODE
#       instead of the built-in public API?        =official_cli (needs Node >= 22).
#     - Want the data somewhere else (e.g. a    -> set DATA_DIRECTORY.
#       synced folder or a Termux path)?
#
# HOW VALUES ARE READ (so nothing surprises you)
#
#   - One setting per line, exactly `KEY=value`. No spaces around the `=`.
#   - Lines starting with `#` are comments. Blank lines are ignored.
#   - An EMPTY value (e.g. `AI_API_KEY=`) is the same as not setting the
#     variable at all: the built-in default applies. So in this file, blank
#     means "leave it alone".
#   - Quotes are optional; they are stripped (`AI_MODEL="gpt-4o-mini"` is
#     fine and equals `AI_MODEL=gpt-4o-mini`).
#   - Precedence, highest wins:
#       1. command-line flags (e.g. `--json`)
#       2. variables exported in your shell (a real `export LOG_LEVEL=DEBUG`
#          overrides what .env says, because the shell value already exists)
#       3. this .env file
#       4. the persistent config file (`bountypilot config set KEY value`
#          writes to <data directory>/config.json)
#       5. built-in defaults (the "Default" shown for each variable below)
#   - Secrets are never printed: `bountypilot config show` masks every key
#     whose name ends in KEY/TOKEN/SECRET/PASSWORD/PRIVATE_KEY.
#   - NEVER commit a filled-in .env to git. It is already in .gitignore.
#   - Verify what the program actually sees with:
#
#       bountypilot config show
#
#
# ----------------------------------------------------------------------------
# 1. GIBWORK INTEGRATION — how BountyPilot talks to Gibwork
# ----------------------------------------------------------------------------
#
# GIBWORK_INTEGRATION_MODE
#   What: which transport is used for bounty data.
#   Allowed: public_api | official_cli
#   Default: public_api
#   Details:
#     - public_api  — BountyPilot's built-in Python adapter over Gibwork's
#       documented public read endpoints (GET /explore, GET /tasks/{id}).
#       No extra software, no account, works immediately. This is what most
#       users want and the only mode fully supported on Termux.
#     - official_cli — delegates listing/detail to the OFFICIAL @gibwork/cli
#       Node.js package. Only choose this if you specifically want the
#       official tool; it needs Node.js >= 22 installed (`node --version`)
#       and a Solana keypair configured in that CLI for anything beyond
#       public listing. Point GIBWORK_CLI_PATH at the executable.
#   Example: GIBWORK_INTEGRATION_MODE=public_api
GIBWORK_INTEGRATION_MODE=public_api

# GIBWORK_BASE_URL
#   What: root URL of the Gibwork API.
#   Default: https://api.gib.work
#   When to change: almost never. The alternative documented host is
#     https://api2.gib.work; some datacenter IPs are blocked there by the
#     provider's firewall, and BountyPilot can fail over between hosts
#     automatically when one is unreachable. Set this explicitly only to
#     pin a host (or to point at a self-hosted/mock server for testing).
#   Example: GIBWORK_BASE_URL=https://api.gib.work
GIBWORK_BASE_URL=https://api.gib.work

# GIBWORK_API_KEY
#   What: an optional API key sent as a bearer token.
#   Default: (empty — no key, which is what the public endpoints expect)
#   When to set: only if Gibwork ever publishes documented API-key auth.
#     No API key is needed today: listing and bounty details are public.
#     If you set one and the provider rejects it, BountyPilot retries
#     without it and reports the rejection honestly via
#     `bountypilot gibwork auth status` — nothing breaks.
#   Example: GIBWORK_API_KEY=            (leave empty)
GIBWORK_API_KEY=

# GIBWORK_CLI_PATH
#   What: path to the official Gibwork CLI executable.
#   Used by: official_cli mode only (ignored in public_api mode).
#   Default: (empty — `gibwork` is looked up on your PATH)
#   Example: GIBWORK_CLI_PATH=/usr/local/bin/gibwork
GIBWORK_CLI_PATH=

# GIBWORK_TIMEOUT_SECONDS
#   What: how many seconds to wait for one Gibwork API response before
#     giving up that request.
#   Allowed: 1–120 (whole seconds)
#   Default: 20
#   When to change: raise it (e.g. 45) on a very slow mobile connection;
#     lower it if you want failures to surface faster in scripts.
GIBWORK_TIMEOUT_SECONDS=20

# GIBWORK_RETRY_LIMIT
#   What: how many times a failed READ request is retried automatically
#     (with backoff) before an error is shown.
#   Allowed: 0–5
#   Default: 2
#   When to change: 0–1 on flaky mobile data if you prefer fast, visible
#     errors; leave at 2 otherwise.
GIBWORK_RETRY_LIMIT=2

# GIBWORK_REQUEST_INTERVAL_SECONDS
#   What: minimum pause between consecutive Gibwork requests (a politeness
#     throttle so we never hammer the provider).
#   Allowed: 0–60 (decimal seconds allowed, e.g. 0.5)
#   Default: 1.0
#   When to change: almost never; keep >= 0.5.
GIBWORK_REQUEST_INTERVAL_SECONDS=1.0
#
# NOTE — pagination: the public API serves page 1 (up to 15 bounties) to
# unauthenticated callers; deeper pages are auth-gated by Gibwork itself.
# BountyPilot detects this and says so instead of failing — it is provider
# behaviour, not a setting here.
#
# ----------------------------------------------------------------------------
# 2. AI PROVIDER — powers `analyze`/`plan` wording (everything works without it)
# ----------------------------------------------------------------------------
#
# Analysis is 100% functional with the default local provider and zero
# network access. Configure a remote model only if you want AI-worded
# summaries on top of the deterministic heuristics.
#
# AI_PROVIDER
#   What: which analysis engine is used.
#   Allowed: local | remote
#   Default: local
#     - local  — built-in deterministic heuristics. Offline, free, no key,
#       identical results on every run. All estimates are labelled and no
#       skill is ever claimed unless you configured it.
#     - remote — an OpenAI-compatible chat-completions endpoint you point
#       at with AI_BASE_URL/AI_MODEL/AI_API_KEY. Requires all three set;
#       if a remote call fails, BountyPilot degrades gracefully to local.
AI_PROVIDER=local

# LOCAL_MODEL_NAME
#   What: a label for the local engine, shown in reports/analysis output.
#   Default: bountypilot-heuristic-v1
#   When to change: cosmetic only — you can ignore this.
LOCAL_MODEL_NAME=bountypilot-heuristic-v1

# AI_BASE_URL
#   What: root of an OpenAI-compatible API (the URL that ends before
#     "/chat/completions"). Applied only when AI_PROVIDER=remote.
#   Default: (empty — remote mode unusable until set)
#   Examples:
#     OpenAI:     https://api.openai.com/v1
#     OpenRouter: https://openrouter.ai/api/v1
#     Groq:       https://api.groq.com/openai/v1
#     Local LLM:  http://localhost:8080/v1
AI_BASE_URL=

# AI_MODEL
#   What: the model id the remote endpoint should use.
#   Default: (empty — remote mode unusable until set)
#   Examples: gpt-4o-mini, meta-llama/llama-3.1-8b-instruct, llama3
AI_MODEL=

# AI_API_KEY
#   What: secret token for the remote endpoint. Kept only in this file or
#     your shell environment; never stored in the database, never written
#     to reports/evidence, always masked by `bountypilot config show`.
#   Default: (empty — remote mode unusable until set)
#   Privacy: only the bounty title and its public description are sent to
#     the remote provider — never your files, config, or keys.
AI_API_KEY=
#
# Complete remote-AI example — copy these four lines into .env:
#   AI_PROVIDER=remote
#   AI_BASE_URL=https://api.openai.com/v1
#   AI_MODEL=gpt-4o-mini
#   AI_API_KEY=sk-...your-key...
#
# ----------------------------------------------------------------------------
# 3. STORAGE, LOGGING, OUTPUT — where data lives and how it looks
# ----------------------------------------------------------------------------
#
# DATA_DIRECTORY
#   What: the folder holding everything BountyPilot creates: the SQLite
#     database (bountypilot.db), config.json, evidence/, exports/.
#   Default: $XDG_DATA_HOME/bountypilot, or ~/.local/share/bountypilot
#   When to set: you want data on another disk, in a synced folder, or in a
#     Termux-friendly path. The directory is created with private
#     permissions (0700) on first use.
#   Example: DATA_DIRECTORY=/sdcard/bountypilot-data
DATA_DIRECTORY=

# DATABASE_URL
#   What: explicit SQLite database file location, overriding the default
#     (<DATA_DIRECTORY>/bountypilot.db).
#   Default: (empty — use <DATA_DIRECTORY>/bountypilot.db)
#   Format: either a plain path or a sqlite:/// URL. Both are accepted:
#     /home/me/bounties.db
#     sqlite:////home/me/bounties.db   (note the four slashes = absolute path)
#   When to set: rare — e.g. keeping the database separate from the data
#     directory. Back it up by copying the file while no command is running.
DATABASE_URL=

# LOG_LEVEL
#   What: verbosity of the log file/diagnostic output.
#   Allowed: DEBUG | INFO | WARNING | ERROR
#   Default: WARNING
#   When to change: set DEBUG while reporting a bug or inspecting API
#     behaviour (run with `--debug` on the command line for a full stack
#     trace too). Secrets are redacted in every level.
LOG_LEVEL=WARNING

# OUTPUT_FORMAT
#   What: default rendering of commands.
#   Allowed: table | json
#   Default: table
#   When to change: set json if you mostly pipe BountyPilot into other
#     tools (jq, scripts). The --json flag overrides this per run, and
#     JSON output is always clean JSON (no decoration).
OUTPUT_FORMAT=table

# REQUEST_TIMEOUT_SECONDS / MAX_RETRIES
#   What: generic HTTP timeout (1–120 s) and retry count (0–5) honoured by
#     integration clients that do not have a Gibwork-specific setting.
#     Today the Gibwork variables above take precedence for Gibwork calls.
#   Defaults: 20 and 2
#   When to change: only if you add other HTTP-based integrations or want
#     a single global knob.
REQUEST_TIMEOUT_SECONDS=20
MAX_RETRIES=2
#
# ----------------------------------------------------------------------------
# 4. Ready-made scenarios — copy the lines you need into .env
# ----------------------------------------------------------------------------
#
# A) "I just want it to work." -> nothing below; defaults already do this.
#    (This whole file can stay exactly as shipped: every value shown equals
#    the default, and empty values mean "unset".)
#
# B) Remote AI for richer analysis wording (OpenAI example):
#    AI_PROVIDER=remote
#    AI_BASE_URL=https://api.openai.com/v1
#    AI_MODEL=gpt-4o-mini
#    AI_API_KEY=sk-...your-key...
#
# C) Free/local AI, no cloud (llama.cpp server on your machine):
#    AI_PROVIDER=remote
#    AI_BASE_URL=http://localhost:8080/v1
#    AI_MODEL=llama3
#    AI_API_KEY=local
#
# D) Official @gibwork/cli instead of the built-in adapter (Node >= 22):
#    GIBWORK_INTEGRATION_MODE=official_cli
#    GIBWORK_CLI_PATH=/usr/local/bin/gibwork
#
# E) Slow mobile connection:
#    GIBWORK_TIMEOUT_SECONDS=45
#    GIBWORK_RETRY_LIMIT=3
#
# F) Keep all data in a custom folder (e.g. Termux shared storage):
#    DATA_DIRECTORY=/sdcard/bountypilot-data
#
# G) Machine-readable output for scripts:
#    OUTPUT_FORMAT=json
#
# After editing .env, confirm the effective values with:
#   bountypilot config show
